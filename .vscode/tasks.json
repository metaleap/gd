{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "mesonBuildDbg",
            "command": "time meson compile -C .build/dbg && cp .build/dbg/compile_commands.json .",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "mesonBuildDev",
            "command": "time meson compile -C .build/dev && cp .build/dev/compile_commands.json .",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "shell",
            "label": "mesonBuildReleaseGcc",
            "command": "time meson compile -C .build/release_gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "shell",
            "label": "mesonBuildReleaseClang",
            "command": "time meson compile -C .build/release_clang",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}
