{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Wicked Editor debug build",
            "type": "gdb",
            "request": "launch",
            "target": "Editor",
            "cwd": "${fileWorkspaceFolder}/3rdparty/turanszkij_WickedEngine/.build_dbg/Editor",
            "env": {
                "UBSAN_OPTIONS": "print_stacktrace=1",
                "LSAN_OPTIONS": "log_threads=1"
            },
            "valuesFormatting": "disabled",
            "internalConsoleOptions": "openOnSessionStart"
        },
